# OpenAI API Configuration
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-key-here

# Google API Configuration (for Google Models/Vertex AI)
# Get your key from: https://cloud.google.com/docs/authentication
GOOGLE_API_KEY=your-google-key-here

# Anthropic Claude API Configuration
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenRouter API Configuration (multi-model provider)
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# HuggingFace Hub Configuration (for model downloads)
# Get your token from: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your-token-here
